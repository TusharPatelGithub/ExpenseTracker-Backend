    {
      "name": "7. Report API",
      "item": [
        {
          "name": "Get Monthly Summary",
          "request": {
            "method": "GET",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]},
            "url": {
              "raw": "{{report_url}}/api/reports/monthly?month=5&year=2026",
              "host": ["{{report_url}}"],
              "path": ["api", "reports", "monthly"],
              "query": [
                {"key": "month", "value": "5"},
                {"key": "year", "value": "2026"}
              ]
            }
          }
        },
        {
          "name": "Get Category Breakdown",
          "request": {
            "method": "GET",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]},
            "url": {
              "raw": "{{report_url}}/api/reports/category-breakdown?start=2026-05-01T00:00:00Z&end=2026-05-31T23:59:59Z",
              "host": ["{{report_url}}"],
              "path": ["api", "reports", "category-breakdown"],
              "query": [
                {"key": "start", "value": "2026-05-01T00:00:00Z"},
                {"key": "end", "value": "2026-05-31T23:59:59Z"}
              ]
            }
