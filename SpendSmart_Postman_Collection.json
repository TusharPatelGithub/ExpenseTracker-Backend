{
  "info": {
    "name": "SpendSmart Microservices API",
    "description": "Postman Collection for SpendSmart Backend Testing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "auth_url", "value": "http://localhost:5260", "type": "string"},
    {"key": "category_url", "value": "http://localhost:5026", "type": "string"},
    {"key": "expense_url", "value": "http://localhost:5227", "type": "string"},
    {"key": "income_url", "value": "http://localhost:5257", "type": "string"},
    {"key": "budget_url", "value": "http://localhost:5138", "type": "string"},
    {"key": "notification_url", "value": "http://localhost:5267", "type": "string"},
    {"key": "report_url", "value": "http://localhost:5191", "type": "string"},
    {"key": "token", "value": "", "type": "string"}
  ],
  "item": [
    {
      "name": "1. Auth API",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {
              "raw": "{{auth_url}}/api/users/register",
              "host": ["{{auth_url}}"],
              "path": ["api", "users", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"fullName\": \"Test User\",\n    \"email\": \"test@example.com\",\n    \"password\": \"Password123!\",\n    \"currency\": \"INR\"\n}"
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {
              "raw": "{{auth_url}}/api/users/login",
              "host": ["{{auth_url}}"],
              "path": ["api", "users", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"Password123!\"\n}"
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]},
            "url": {
              "raw": "{{auth_url}}/api/users/profile",
              "host": ["{{auth_url}}"],
              "path": ["api", "users", "profile"]
            }
          }
        },
        {
          "name": "Admin - Get All Users",
          "request": {
            "method": "GET",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]},
            "url": {
              "raw": "{{auth_url}}/api/admin/users",
              "host": ["{{auth_url}}"],
              "path": ["api", "admin", "users"]
            }
          }
        },
        {
          "name": "Admin - Analytics",
          "request": {
            "method": "GET",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]},
            "url": {
              "raw": "{{auth_url}}/api/admin/analytics",
              "host": ["{{auth_url}}"],
              "path": ["api", "admin", "analytics"]
            }
          }
        }
      ]
    },
