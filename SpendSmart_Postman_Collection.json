            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Gym & Fitness\",\n    \"icon\": \"dumbbell\",\n    \"color\": \"#33FF57\",\n    \"type\": \"EXPENSE\"\n}"
            }
          }
        }
